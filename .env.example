# Telegram
BOT_TOKEN=123456:ABC-your-token-from-botfather
BOT_USERNAME=DiscoveryCampBot
# Random string, also passed to setWebhook as secret_token (npm run set-webhook does it)
#openssl rand -base64 32
WEBHOOK_SECRET=change-me-random-string
# Comma-separated Telegram user IDs of organizers
ADMIN_IDS=123456789

# Google Sheets (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=bot@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key file, keep the \n escapes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SHEET_ID=1AbC...your-spreadsheet-id
# Optional: read-only shared spreadsheet with the camp grid (schedule, master classes)
GRID_SHEET_ID=
/
# Tab with Google Form responses and exact header texts of the columns
RESPONSES_TAB=Form Responses 1
NAME_HEADER=Прізвище та ім'я
CHECKIN_HEADER=Checked in
TELEGRAM_ID_HEADER=Telegram ID
# Optional: column with the visitor's team, used to pick the team leader video
TEAM_HEADER=Команда

# Fallback video if no team-specific video found (Telegram file_id)
DEFAULT_VIDEO_FILE_ID=

# Vercel Cron protection (Vercel sets this automatically in prod; mirror it here)
CRON_SECRET=change-me-too

# Public URL of the deployed app, used by npm run set-webhook
PUBLIC_URL=https://your-app.vercel.app
